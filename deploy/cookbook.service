# The cookbook web app: one uvicorn worker on port 80, as the unprivileged cookbook user.
# The host shares its CPU and memory with other services, so the app is capped and
# sandboxed. Host-specific paths it must never see go in a drop-in:
# /etc/systemd/system/cookbook.service.d/*.conf (InaccessiblePaths=...).
#
# The virtualenv's Python must live outside /home (ProtectHome hides it): install with
# UV_PYTHON_INSTALL_DIR=/srv/cookbook/python, as README.md describes.

[Unit]
Description=Cookbook web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cookbook
Group=cookbook
WorkingDirectory=/srv/cookbook/cookbook
# COOKBOOK_DB_PATH and COOKBOOK_SECRET_KEY (see README.md)
EnvironmentFile=/etc/cookbook/cookbook.env
ExecStart=/srv/cookbook/cookbook/.venv/bin/uvicorn --factory cookbook.app:create_app --host 0.0.0.0 --port 80 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/cookbook/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Other services' processes are invisible: /proc shows only the app's own.
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

Nice=5
CPUQuota=100%
MemoryMax=300M

[Install]
WantedBy=multi-user.target
