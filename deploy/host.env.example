# Copy to deploy/host.env (git-ignored) and fill in: the laptop's view of the host, for
# the deploy and recipe-db scripts. Nothing here is read by the app itself.

# SSH target for the host, and the user that owns /srv/cookbook/cookbook
DEPLOY_HOST=<host>.local
DEPLOY_USER=<user>

# The host's reserved address, published as cookbook.local (COOKBOOK_MDNS_ADDRESS)
DEPLOY_ADDRESS=192.0.2.10

# Where nightly backups go on the host (COOKBOOK_BACKUP_DIR), ideally another disk
DEPLOY_BACKUP_DIR=/srv/cookbook/backups
